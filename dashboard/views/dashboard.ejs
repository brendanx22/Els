          <!-- Log -->
          <div class="bottom-pane" id="bottom-pane-log">
            <div class="web-terminal-bar">
              <span class="web-terminal-prompt">els&gt;</span>
              <input type="text" id="web-terminal-input" class="web-terminal-input" placeholder="Type terminal command e.g. analyze BTCUSD 15m..." autocomplete="off" />
