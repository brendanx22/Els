<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#131722" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="description" content="ELS Terminal — professional trading analysis" />
    <title>ELS Terminal</title>
    <link rel="icon" type="image/jpeg" href="/els-logo.jpg" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="apple-touch-icon" href="/icon-512.jpg" />
    <meta name="apple-mobile-web-app-title" content="ELS Terminal" />
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" crossorigin />
    <link rel="stylesheet" href="/trading-terminal.css?v=<%= Date.now() %>" />
  </head>
  <body>
    <script>window.TRADING_APP_CONFIG = <%- JSON.stringify(appConfig) %>;</script>

    <main class="tv-shell" id="snapshot-area">

      <!-- ═══════════ TOP BAR ═══════════ -->
      <header class="tv-topbar">

        <div class="brand-lockup">
          <img src="/els-logo.jpg" alt="ELS Terminal" class="brand-logo" style="height:38px;width:38px;object-fit:contain;border-radius:6px;" />
        </div>

        <div class="market-strip">

          <article class="market-pill market-pill--secondary" id="status-card" data-tone="idle">
            <div class="market-pill-label">Engine</div>
            <div style="display:flex;align-items:center;gap:6px">
              <div class="market-pill-value" id="status-label">Idle</div>
              <div class="market-pill-sub" id="status-detail">—</div>
            </div>
          </article>

          <div class="topbar-divider"></div>

          <article class="market-pill">
            <div class="market-pill-label">Symbol</div>
            <div style="display:flex;align-items:center;gap:6px">
              <div class="market-pill-value" id="session-symbol">--</div>
              <div class="market-pill-sub" id="session-timeframe">--</div>
            </div>
          </article>

          <div class="topbar-divider"></div>

          <article class="market-pill">
            <div class="market-pill-label">Price</div>
            <div style="display:flex;align-items:center;gap:6px">
              <div class="market-pill-value" id="headline-price">--</div>
              <div class="market-pill-sub" id="headline-change">--</div>
            </div>
          </article>

          <div class="topbar-divider"></div>

          <article class="market-pill market-pill--secondary">
            <div class="market-pill-label">Last command</div>
            <div style="display:flex;align-items:center;gap:6px">
              <div class="market-pill-value" id="last-command">--</div>
              <div class="market-pill-sub" id="last-command-time">--</div>
            </div>
          </article>

        </div>

        <div class="topbar-actions">
          <button class="topbar-btn accent" id="screener-toggle-btn" aria-label="Open Market Screener">
            <svg viewBox="0 0 16 16" fill="currentColor"><path d="M1 2.5A1.5 1.5 0 0 1 2.5 1h3A1.5 1.5 0 0 1 7 2.5v3A1.5 1.5 0 0 1 5.5 7h-3A1.5 1.5 0 0 1 1 5.5v-3zm8 0A1.5 1.5 0 0 1 10.5 1h3A1.5 1.5 0 0 1 15 2.5v3A1.5 1.5 0 0 1 13.5 7h-3A1.5 1.5 0 0 1 9 5.5v-3zm-8 8A1.5 1.5 0 0 1 2.5 9h3A1.5 1.5 0 0 1 7 10.5v3A1.5 1.5 0 0 1 5.5 15h-3A1.5 1.5 0 0 1 1 13.5v-3zm8 0A1.5 1.5 0 0 1 10.5 9h3a1.5 1.5 0 0 1 1.5 1.5v3a1.5 1.5 0 0 1-1.5 1.5h-3A1.5 1.5 0 0 1 9 13.5v-3z"/></svg>
            <span>Screener</span>
          </button>
          <span class="toolbar-chip" id="watch-state">Paused</span>
          <span class="toolbar-chip" id="next-refresh">Live watch off</span>
          <button class="topbar-btn" id="theme-toggle-btn" aria-label="Toggle theme">
            <svg viewBox="0 0 16 16" fill="currentColor" id="theme-icon">
              <path d="M8 1a7 7 0 1 0 0 14A7 7 0 0 0 8 1zm0 13a6 6 0 1 1 0-12 6 6 0 0 1 0 12z"/>
            </svg>
          </button>
          <button class="topbar-btn primary" id="panel-toggle-btn" aria-label="Toggle analysis panel">
            <svg viewBox="0 0 16 16" fill="currentColor"><path d="M1 2.5A1.5 1.5 0 0 1 2.5 1h3A1.5 1.5 0 0 1 7 2.5v3A1.5 1.5 0 0 1 5.5 7h-3A1.5 1.5 0 0 1 1 5.5v-3zm8 0A1.5 1.5 0 0 1 10.5 1h3A1.5 1.5 0 0 1 15 2.5v3A1.5 1.5 0 0 1 13.5 7h-3A1.5 1.5 0 0 1 9 5.5v-3zm-8 8A1.5 1.5 0 0 1 2.5 9h3A1.5 1.5 0 0 1 7 10.5v3A1.5 1.5 0 0 1 5.5 15h-3A1.5 1.5 0 0 1 1 13.5v-3zm8 0A1.5 1.5 0 0 1 10.5 9h3a1.5 1.5 0 0 1 1.5 1.5v3a1.5 1.5 0 0 1-1.5 1.5h-3A1.5 1.5 0 0 1 9 13.5v-3z"/></svg>
            <span>Analysis</span>
          </button>
        </div>

      </header>

      <!-- ═══════════ WORKSPACE ═══════════ -->
      <section class="tv-workspace">

        <!-- CHART STAGE -->
        <section class="chart-stage chart-stage--tv">

          <!-- High-Impact Macro Risk Warning Banner -->
          <div id="macro-risk-banner" class="macro-risk-banner" hidden>
            <div class="macro-risk-content">
              <span class="macro-risk-icon">⚠️</span>
              <span id="macro-risk-text" class="macro-risk-text">High-Impact News Release Imminent!</span>
            </div>
            <button id="macro-risk-dismiss" class="macro-risk-dismiss" aria-label="Dismiss">×</button>
          </div>

          <div class="chart-toolbar">
            <div class="chart-toolbar-left">
              <div class="toolbar-label">Chart</div>
              <h1 id="headline-symbol">No market selected</h1>
              <p id="headline-meta">Use the terminal to analyze or watch a symbol.</p>
            </div>
            <div class="toolbar-meta">
              <div class="timeframe-buttons" id="timeframe-buttons">
                <button class="tf-btn" data-tf="1m">1m</button>
                <button class="tf-btn" data-tf="5m">5m</button>
                <button class="tf-btn" data-tf="15m">15m</button>
                <button class="tf-btn active" data-tf="1h">1h</button>
                <button class="tf-btn" data-tf="4h">4h</button>
                <button class="tf-btn" data-tf="1d">1d</button>
              </div>
              <button id="rr-tool-btn" class="chart-action-btn" type="button" title="Toggle Risk-to-Reward Box">📐 R:R Tool</button>
              <div class="chart-view-toggle" id="chart-view-toggle" role="tablist" aria-label="Chart mode">
                <button id="chart-mode-tradingview" class="chart-view-button" type="button">TradingView</button>
                <button id="chart-mode-local" class="chart-view-button" type="button">Annotated</button>
              </div>
              <span class="toolbar-chip" id="provider-label">--</span>
              <span class="toolbar-chip" id="updated-stat">--</span>
            </div>
          </div>

          <div class="layer-strip" id="layer-tags">
            <span class="layer-tag">EMA</span>
            <span class="layer-tag">Fib</span>
            <span class="layer-tag">Supply / Demand</span>
            <span class="layer-tag">FVG</span>
            <span class="layer-tag">RSI</span>
          </div>

          <div class="chart-frame">
            <div id="chart-container" class="chart-container"></div>
            <div id="tv-chart-container" class="tv-chart-container" hidden>
              <div id="tv-chart-widget" class="tv-chart-widget"></div>
            </div>
            <div id="chart-annotation-layer" class="chart-annotation-layer"></div>
            <div id="chart-legend" class="chart-legend"></div>
          </div>

          <div class="chart-stats">
            <article class="chart-stat"><span>Bias</span><strong id="bias-stat">--</strong></article>
            <article class="chart-stat"><span>Confidence</span><strong id="confidence-stat">--</strong></article>
            <article class="chart-stat"><span>Momentum</span><strong id="momentum-stat">--</strong></article>
            <article class="chart-stat"><span>Pattern</span><strong id="pattern-stat">--</strong></article>
            <article class="chart-stat"><span>Breakout</span><strong id="breakout-value">--</strong></article>
            <article class="chart-stat"><span>Range loc</span><strong id="range-location-value">--</strong></article>
          </div>

        </section>

        <!-- SLIDE-OVER / BOTTOM-SHEET OVERLAY -->
        <div class="sidebar-overlay" id="sidebar-overlay"></div>

        <!-- ANALYSIS PANEL: bottom sheet on phone, right panel from md breakpoint up -->
        <aside class="smart-sidebar" id="smart-sidebar">

          <div class="sidebar-header">
            <span class="sidebar-header-title">Analysis</span>
            <button class="sidebar-close-btn" id="sidebar-close-btn" aria-label="Close">
              <svg viewBox="0 0 16 16" fill="currentColor"><path d="M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8 2.146 2.854z"/></svg>
            </button>
          </div>

          <!-- Tab bar -->
          <nav class="sidebar-tabs" role="tablist">
            <button class="sidebar-tab active" data-tab="strategy" role="tab">Strategy</button>
            <button class="sidebar-tab" data-tab="patterns" role="tab">Patterns</button>
            <button class="sidebar-tab" data-tab="signals" role="tab">Signals</button>
            <button class="sidebar-tab" data-tab="paper" role="tab">Paper</button>
            <button class="sidebar-tab" data-tab="news" role="tab">News</button>
            <button class="sidebar-tab" data-tab="calendar" role="tab">Calendar</button>
            <button class="sidebar-tab" data-tab="more" role="tab">More</button>
          </nav>

          <div class="sidebar-content">

            <!-- ── STRATEGY ── -->
            <div class="tab-pane active" id="pane-strategy">

              <div class="sidebar-panel thesis-panel">
                <div class="panel-label">Strategy Thesis</div>

                <div class="confluence-row">
                  <div>
                    <div class="confluence-score-big" id="confluence-value">--</div>
                    <span>Confluence</span>
                  </div>
                  <div class="confluence-bar" style="flex:1;margin-left:8px">
                    <div id="confluence-fill" class="confluence-fill"></div>
                  </div>
                </div>

                <p id="thesis-value" class="thesis-copy">Waiting for strategy output from the terminal.</p>

                <div class="data-grid ai-meta-grid">
                  <div class="data-cell"><span>AI Provider</span><strong id="ai-provider-value">--</strong></div>
                  <div class="data-cell"><span>AI Verdict</span><strong id="ai-verdict-value">--</strong></div>
                  <div class="data-cell"><span>Entry Status</span><strong id="ai-status-value">--</strong></div>
                  <div class="data-cell"><span>Confidence</span><strong id="ai-confidence-label">--</strong></div>
                </div>

                <div class="data-grid signal-grid">
                  <div class="data-cell signal-cell"><span>Structure</span><strong id="structure-event-value">--</strong></div>
                  <div class="data-cell signal-cell"><span>Location</span><strong id="location-value">--</strong></div>
                  <div class="data-cell signal-cell"><span>Fib Zone</span><strong id="fib-zone-value">--</strong></div>
                  <div class="data-cell signal-cell"><span>RSI Rule</span><strong id="rsi-rule-value">--</strong></div>
                  <div class="data-cell signal-cell"><span>Regime</span><strong id="regime-value">--</strong></div>
                  <div class="data-cell signal-cell"><span>Volatility</span><strong id="volatility-value">--</strong></div>
                </div>
              </div>

              <div class="sidebar-panel">
                <div class="panel-label">Key Formations</div>
                <div class="pattern-list" id="strategy-pattern-list">
                  <p class="thesis-copy" style="margin:0">Scanning market patterns...</p>
                </div>
              </div>

              <div class="sidebar-panel">
                <div class="panel-label">Scorecard</div>
                <div class="data-grid signal-grid">
                  <div class="data-cell signal-cell"><span>Trend</span><strong id="trend-score-value">--</strong></div>
                  <div class="data-cell signal-cell"><span>Momentum</span><strong id="momentum-score-value">--</strong></div>
                  <div class="data-cell signal-cell"><span>Structure</span><strong id="structure-score-value">--</strong></div>
                  <div class="data-cell signal-cell"><span>Timing</span><strong id="timing-score-value">--</strong></div>
                  <div class="data-cell signal-cell"><span>Volatility</span><strong id="volatility-score-value">--</strong></div>
                  <div class="data-cell signal-cell"><span>ADX</span><strong id="adx-value">--</strong></div>
                </div>
              </div>

              <div class="sidebar-panel">
                <div class="panel-label">Trade Plans</div>
                <div id="setup-stack" class="setup-stack">
                  <article class="setup-card">
                    <div class="setup-label">Awaiting market</div>
                    <strong>No setup yet</strong>
                    <p>Run terminal analysis to build setups.</p>
                  </article>
                </div>
              </div>

            </div><!-- /pane-strategy -->

            <!-- ── PATTERNS ── -->
            <div class="tab-pane" id="pane-patterns">
              <div class="sidebar-panel">
                <div class="panel-label">Advanced Pattern Recognition</div>
                <div class="data-grid signal-grid">
                  <div class="data-cell signal-cell"><span>Candlestick</span><strong id="pattern-candlestick-value" class="pattern-candlestick-value">0</strong></div>
                  <div class="data-cell signal-cell"><span>Chart</span><strong id="pattern-chart-value" class="pattern-chart-value">0</strong></div>
                  <div class="data-cell signal-cell"><span>Harmonic</span><strong id="pattern-harmonic-value" class="pattern-harmonic-value">0</strong></div>
                  <div class="data-cell signal-cell"><span>SMC</span><strong id="pattern-smc-value" class="pattern-smc-value">0</strong></div>
                </div>
                <div class="pattern-list" id="pattern-list">
                  <p class="thesis-copy" style="margin:0">Scanning market patterns...</p>
                </div>
              </div>
            </div><!-- /pane-patterns -->

            <!-- ── SIGNALS ── -->
            <div class="tab-pane" id="pane-signals">

              <div class="signal-panel" id="signal-panel" hidden>
                <div class="panel-label">🎯 Active Signal</div>
                <div class="signal-header">
                  <span class="signal-direction" id="signal-direction">--</span>
                  <span class="signal-confidence" id="signal-confidence">--%</span>
                </div>
                <div class="data-grid signal-grid">
                  <div class="data-cell signal-cell"><span>Entry</span><strong id="signal-entry-value">--</strong></div>
                  <div class="data-cell signal-cell"><span>Stop Loss</span><strong id="signal-stop-value" class="color-red">--</strong></div>
                  <div class="data-cell signal-cell"><span>Target 1</span><strong id="signal-target1-value" class="color-green">--</strong></div>
                  <div class="data-cell signal-cell"><span>R:R</span><strong id="signal-rr-value">--</strong></div>
                </div>
                <p id="signal-catalyst" class="thesis-copy" style="margin-top:8px">--</p>
                <button class="action-btn-full" id="paper-trade-signal-btn" style="margin-top:10px">⚡ Execute Paper Trade</button>
              </div>

              <div class="sidebar-panel">
                <div class="panel-label">Predictive Analytics</div>
                <div class="data-grid signal-grid">
                  <div class="data-cell signal-cell"><span>1h Target</span><strong id="prediction-1h-value">--</strong></div>
                  <div class="data-cell signal-cell"><span>4h Target</span><strong id="prediction-4h-value">--</strong></div>
                  <div class="data-cell signal-cell"><span>Volatility</span><strong id="prediction-vol-value">--</strong></div>
                  <div class="data-cell signal-cell"><span>Confidence</span><strong id="prediction-confidence-value">--</strong></div>
                </div>
                <div class="panel-label secondary">Probabilities</div>
                <div class="probability-bars" id="probability-bars">
                  <div class="prob-bar">
                    <span>Bullish</span>
                    <div class="prob-fill"><div class="prob-fill-inner bull" id="prob-bullish" style="width:0%"></div></div>
                    <strong id="prob-bullish-value">0%</strong>
                  </div>
                  <div class="prob-bar">
                    <span>Bearish</span>
                    <div class="prob-fill"><div class="prob-fill-inner bear" id="prob-bearish" style="width:0%"></div></div>
                    <strong id="prob-bearish-value">0%</strong>
                  </div>
                  <div class="prob-bar">
                    <span>Sideways</span>
                    <div class="prob-fill"><div class="prob-fill-inner side" id="prob-sideways" style="width:0%"></div></div>
                    <strong id="prob-sideways-value">0%</strong>
                  </div>
                </div>
              </div>

              <div class="sidebar-panel">
                <div class="panel-label">Multi-Timeframe</div>
                <div class="mtf-score-display" id="confluence-mtf-score">
                  <span>Score</span>
                  <strong id="mtf-score-value">--</strong>
                </div>
                <div class="data-grid signal-grid">
                  <div class="data-cell signal-cell"><span>Direction</span><strong id="mtf-direction-value">--</strong></div>
                  <div class="data-cell signal-cell"><span>Strength</span><strong id="mtf-strength-value">--</strong></div>
                  <div class="data-cell signal-cell"><span>Alignment</span><strong id="mtf-alignment-value">--</strong></div>
                  <div class="data-cell signal-cell"><span>Divergences</span><strong id="mtf-divergences-value">--</strong></div>
                </div>
              </div>

            </div><!-- /pane-signals -->

            <!-- ── PAPER TRADING ── -->
            <div class="tab-pane" id="pane-paper">

              <div class="sidebar-panel">
                <div class="panel-label">Virtual Portfolio ($100k)</div>
                <div class="data-grid signal-grid">
                  <div class="data-cell signal-cell"><span>Balance</span><strong id="paper-balance-value">$100,000.00</strong></div>
                  <div class="data-cell signal-cell"><span>Equity</span><strong id="paper-equity-value">$100,000.00</strong></div>
                  <div class="data-cell signal-cell"><span>Open PnL</span><strong id="paper-unrealized-value">$0.00</strong></div>
                  <div class="data-cell signal-cell"><span>Win Rate</span><strong id="paper-winrate-value">--</strong></div>
                </div>
              </div>

              <div class="sidebar-panel">
                <div class="panel-label">Position Size & Risk Calculator</div>
                <div class="paper-calc-grid">
                  <div class="paper-input-group">
                    <label>Risk %</label>
                    <input type="number" id="calc-risk-pct" value="1.0" step="0.1" min="0.1" max="10" />
                  </div>
                  <div class="paper-input-group">
                    <label>Calculated Lot / Units</label>
                    <strong id="calc-output-lots" class="calc-highlight">--</strong>
                  </div>
                </div>
                <div class="paper-order-actions">
                  <button class="order-btn buy" id="paper-quick-buy-btn">BUY / LONG</button>
                  <button class="order-btn sell" id="paper-quick-sell-btn">SELL / SHORT</button>
                </div>
              </div>

              <div class="sidebar-panel">
                <div class="panel-label">Active Open Positions</div>
                <div id="paper-positions-container" class="paper-positions-list">
                  <p class="thesis-copy" style="margin:0">No open positions. Use 1-click execute to enter.</p>
                </div>
              </div>

              <div class="sidebar-panel">
                <div class="panel-label">Closed Trade Journal</div>
                <div id="paper-history-container" class="paper-history-list">
                  <p class="thesis-copy" style="margin:0">No closed trades yet.</p>
                </div>
              </div>

            </div><!-- /pane-paper -->

            <!-- ── NEWS ── -->
            <div class="tab-pane" id="pane-news">

              <div class="sidebar-panel">
                <div class="panel-label">News Analysis</div>
                <div class="data-grid signal-grid">
                  <div class="data-cell signal-cell"><span>Sentiment</span><strong id="news-sentiment-value">--</strong></div>
                  <div class="data-cell signal-cell"><span>Impact</span><strong id="news-impact-value">--</strong></div>
                  <div class="data-cell signal-cell"><span>Articles</span><strong id="news-articles-value">--</strong></div>
                  <div class="data-cell signal-cell"><span>Key Events</span><strong id="news-events-value">--</strong></div>
                </div>
                <div class="panel-label secondary">Summary</div>
                <div class="news-summary" id="news-summary-value">No news data available.</div>
              </div>

              <div class="sidebar-panel">
                <div class="panel-label">Historical Movements</div>
                <div class="data-grid signal-grid">
                  <div class="data-cell signal-cell"><span>Price Change</span><strong id="movement-change-value">--</strong></div>
                  <div class="data-cell signal-cell"><span>Volatility</span><strong id="movement-volatility-value">--</strong></div>
                  <div class="data-cell signal-cell"><span>Momentum</span><strong id="movement-momentum-value">--</strong></div>
                  <div class="data-cell signal-cell"><span>Trend</span><strong id="movement-trend-value">--</strong></div>
                  <div class="data-cell signal-cell"><span>Patterns</span><strong id="movement-patterns-value">--</strong></div>
                  <div class="data-cell signal-cell"><span>Support</span><strong id="movement-support-value">--</strong></div>
                  <div class="data-cell signal-cell"><span>Resistance</span><strong id="movement-resistance-value">--</strong></div>
                  <div class="data-cell signal-cell"><span>Volume</span><strong id="movement-volume-value">--</strong></div>
                </div>
              </div>

              <div class="sidebar-panel">
                <div class="panel-label">Sentiment Timeline</div>
                <div id="sentiment-timeline-chart" class="mini-chart">
                  <canvas id="sentiment-canvas"></canvas>
                </div>
              </div>

            </div><!-- /pane-news -->

            <!-- ── CALENDAR ── -->
            <div class="tab-pane" id="pane-calendar">

              <div class="sidebar-panel">
                <div class="panel-label">Macro Economic Horizon</div>
                <div id="calendar-events-container" class="calendar-events-list">
                  <p class="thesis-copy" style="margin:0">Loading upcoming economic releases...</p>
                </div>
              </div>

            </div><!-- /pane-calendar -->

            <!-- ── MORE ── -->
            <div class="tab-pane" id="pane-more">

              <div class="sidebar-panel">
                <div class="panel-label">🔔 Webhook & Telegram / Discord Alerts</div>
                <div class="webhook-config-wrap">
                  <div class="paper-input-group" style="margin-bottom:8px">
                    <label>Discord Webhook URL</label>
                    <input type="text" id="cfg-discord-webhook" placeholder="https://discord.com/api/webhooks/..." />
                  </div>
                  <button class="action-btn-small" id="test-discord-btn" style="margin-bottom:12px">Test Discord Webhook</button>

                  <div class="paper-input-group" style="margin-bottom:8px">
                    <label>Telegram Bot Token</label>
                    <input type="text" id="cfg-tg-token" placeholder="123456:ABC-DEF..." />
                  </div>
                  <div class="paper-input-group" style="margin-bottom:8px">
                    <label>Telegram Chat ID</label>
                    <input type="text" id="cfg-tg-chatid" placeholder="@mychannel or -100123..." />
                  </div>
                  <button class="action-btn-small" id="test-telegram-btn" style="margin-bottom:12px">Test Telegram Alert</button>
                </div>
              </div>

