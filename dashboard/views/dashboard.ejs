        <div class="process-loading-bar-fill"></div>
      </div>
      <!-- Corner pill -->
      <div class="process-loading-pill">
        <div class="process-loading-dot"></div>
        <span class="process-loading-text" id="process-loading-text">Analyzing...</span>
      </div>
    </div>

    <!-- ── Inline UI controller ── -->
    <script>
    (function() {

      /* ── Analysis panel toggle ── */
      var sidebar   = document.getElementById('smart-sidebar');
      var overlay   = document.getElementById('sidebar-overlay');
      var openBtn   = document.getElementById('panel-toggle-btn');
      var closeBtn  = document.getElementById('sidebar-close-btn');

      function openPanel()  { sidebar.classList.add('open');  overlay.classList.add('active'); document.body.style.overflow = 'hidden'; }
      function closePanel() { sidebar.classList.remove('open'); overlay.classList.remove('active'); document.body.style.overflow = ''; }

      if (openBtn)  openBtn.addEventListener('click', function() { sidebar.classList.contains('open') ? closePanel() : openPanel(); });
      if (closeBtn) closeBtn.addEventListener('click', closePanel);
      if (overlay)  overlay.addEventListener('click', closePanel);

      /* Swipe-down-to-close on the bottom sheet (touch only, mobile breakpoint) */
      (function enableSwipeToClose() {
        var startY = null;
        var currentY = null;
        var dragging = false;

        sidebar.addEventListener('touchstart', function(e) {
          if (window.innerWidth >= 768) return; // only a bottom sheet below md
          if (sidebar.scrollTop > 0) return;
          startY = e.touches[0].clientY;
          dragging = true;
          sidebar.style.transition = 'none';
        }, { passive: true });

        sidebar.addEventListener('touchmove', function(e) {
          if (!dragging || startY === null) return;
          currentY = e.touches[0].clientY;
          var delta = currentY - startY;
          if (delta > 0) sidebar.style.transform = 'translateY(' + delta + 'px)';
        }, { passive: true });

        sidebar.addEventListener('touchend', function() {
          if (!dragging) return;
          dragging = false;
          sidebar.style.transition = '';
          sidebar.style.transform = '';
          var delta = (currentY || 0) - (startY || 0);
          if (delta > 90) closePanel();
          startY = null;
          currentY = null;
        });
      })();

      /* ── Sidebar tabs ── */
      document.querySelectorAll('.sidebar-tab').forEach(function(tab) {
        tab.addEventListener('click', function() {
          document.querySelectorAll('.sidebar-tab').forEach(function(t) { t.classList.remove('active'); });
          document.querySelectorAll('.tab-pane').forEach(function(p) { p.classList.remove('active'); });
          tab.classList.add('active');
          var pane = document.getElementById('pane-' + tab.dataset.tab);
          if (pane) pane.classList.add('active');
          if (tab.dataset.tab === 'news' && typeof window.drawSentimentTimeline === 'function') {
            requestAnimationFrame(function() {
              window.drawSentimentTimeline();
            });
          }
        });
      });

      /* ── Bottom bar expand/collapse ── */
      var bottomEl     = document.getElementById('tv-bottom');
      var toggleBtn    = document.getElementById('bottom-toggle-btn');
      var toggleSpan   = toggleBtn ? toggleBtn.querySelector('span') : null;

      function setExpanded(expanded) {
        bottomEl.classList.toggle('expanded', expanded);
        if (toggleSpan) toggleSpan.textContent = expanded ? 'Collapse' : 'Expand';
      }

      if (toggleBtn) {
        toggleBtn.addEventListener('click', function(e) {
          e.stopPropagation();
          setExpanded(!bottomEl.classList.contains('expanded'));
        });
      }

      /* ── Theme toggle ── */
      var themeToggleBtn = document.getElementById('theme-toggle-btn');
      var themeIcon = document.getElementById('theme-icon');
      
      function toggleTheme() {
        document.body.classList.toggle('light-mode');
        var isLight = document.body.classList.contains('light-mode');
        
        // Update icon
        if (isLight) {
          themeIcon.innerHTML = '<path d="M8 1a7 7 0 1 0 0 14A7 7 0 0 0 8 1zm0 13a6 6 0 1 1 0-12 6 6 0 0 1 0 12z"/><path d="M8 4a4 4 0 1 0 0 8 4 4 0 0 0 0-8zm0 7a3 3 0 1 1 0-6 3 3 0 0 1 0 6z"/>';
        } else {
          themeIcon.innerHTML = '<path d="M8 1a7 7 0 1 0 0 14A7 7 0 0 0 8 1zm0 13a6 6 0 1 1 0-12 6 6 0 0 1 0 12z"/>';
        }
        
        // Re-render chart with new colors
        if (window.chartState && window.chartState.instance && window.chartState.instance.setStyles) {
          window.chartState.instance.setStyles(window.getKLineStyles());
        }
        
        // Save preference
        localStorage.setItem('theme', isLight ? 'light' : 'dark');
      }
      
      if (themeToggleBtn) {
        themeToggleBtn.addEventListener('click', toggleTheme);
      }
      
      // Load saved theme preference
      var savedTheme = localStorage.getItem('theme');
      if (savedTheme === 'light') {
        document.body.classList.add('light-mode');
        if (themeIcon) {
          themeIcon.innerHTML = '<path d="M8 1a7 7 0 1 0 0 14A7 7 0 0 0 8 1zm0 13a6 6 0 1 1 0-12 6 6 0 0 1 0 12z"/><path d="M8 4a4 4 0 1 0 0 8 4 4 0 0 0 0-8zm0 7a3 3 0 1 1 0-6 3 3 0 0 1 0 6z"/>';
        }
      }

      /* ── Bottom tabs ── */
      document.querySelectorAll('.bottom-tab').forEach(function(tab) {
        tab.addEventListener('click', function(e) {
          e.stopPropagation();
          document.querySelectorAll('.bottom-tab').forEach(function(t) { t.classList.remove('active'); });
          document.querySelectorAll('.bottom-pane').forEach(function(p) { p.classList.remove('active'); });
          tab.classList.add('active');
          var pane = document.getElementById('bottom-pane-' + tab.dataset.bottomTab);
          if (pane) pane.classList.add('active');
          setExpanded(true);
        });
      });

    })();
    </script>

    <script src="/vendor/klinecharts/klinecharts.min.js"></script>
    <script src="/trading-terminal.js?v=<%= Date.now() %>"></script>
  </body>
</html>
