              <div class="level-cell"><span>Resistance</span><strong id="resistance-value">--</strong></div>
              <div class="level-cell"><span>Demand Zone</span><strong id="support-zone-value">--</strong></div>
              <div class="level-cell"><span>Supply Zone</span><strong id="resistance-zone-value">--</strong></div>
              <div class="level-cell"><span>Fib Entry</span><strong id="fib-entry-value">--</strong></div>
              <div class="level-cell"><span>Fib Invalid</span><strong id="fib-invalid-value">--</strong></div>
              <div class="level-cell"><span>Range Mid</span><strong id="range-midpoint-value">--</strong></div>
            </div>
          </div>

          <!-- AI Brief -->
          <div class="bottom-pane" id="bottom-pane-brief">
            <div class="brief-grid">
              <div>
                <div class="brief-section-label">Execution Brief</div>
                <ul id="risk-list" class="text-list"><li>Waiting for AI risk review.</li></ul>
              </div>
              <div>
                <div class="brief-section-label">Next Actions</div>
                <ul id="next-actions-list" class="text-list"><li>Run terminal analysis to generate an AI action plan.</li></ul>
              </div>
              <div>
                <div class="brief-section-label">Invalidations</div>
